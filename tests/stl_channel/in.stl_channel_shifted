# 3D Poiseuille flow with no-slip walls read from an STL fluid-volume box.
# Same channel with the STL translated +0.3 dx in y, so wall links get
# sub-cell distances (lambda=0.2 lower, 0.8 upper). Validates that Bouzidi
# interpolated bounce-back places the wall at the true STL surface.
# The STL encloses the fluid volume from y=-0.5 to y=31.5 and uses
# solid_side outside, so only the y ghost layers are solid for this test.
# Validate: bash validate.sh (inline check against the shifted-wall parabola;
# ../poiseuille2d/validate.py assumes unshifted walls and does not apply here)

units           lj
dimension       3
boundary        p p p
atom_style      atomic

region          box block 0.0 8.0 0.0 32.0 0.0 8.0
create_box      1 box
create_atoms    1 single 4.0 0.5 4.0
mass            1 1.0
pair_style      none

group           noatoms empty

timestep        1.0

fix  flow noatoms couplb 8 32 8 0.1 1.0 &
     solid_stl channel_walls.stl no-slip &
     solid_side outside &
     solid_translate 0.0 0.3 0.0 &
     gravity 5e-6 0.0 0.0 &
     output 5000 couplb_stl_shifted.dat &
     check_every 2000

thermo          5000
thermo_style    custom step cpu
run             50000
print "=== STL channel Poiseuille test done ==="
