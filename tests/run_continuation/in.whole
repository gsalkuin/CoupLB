# Run-continuation invariant -- reference: single uninterrupted run.
# Compare against in.split (same physics, `run` split in two).
# The step-10000 profile blocks must be bit-identical.
# See docs/DEVNOTES_2026-07-02.md for the bug this guards against.

units           lj
dimension       2
boundary        p f p
atom_style      atomic

region          box block 0.0 16.0 0.0 64.0 -0.5 0.5
create_box      1 box
create_atoms    1 single 8.0 32.0 0.0
mass            1 1.0
pair_style      none

group           noatoms empty

timestep        1.0

fix flow noatoms couplb 16 64 1 0.1 1.0 &
    wall_y 1 1 &
    gravity 5e-6 0.0 0.0 &
    kernel roma &
    output 5000 prof_whole.dat

thermo          5000
thermo_style    custom step cpu
run             10000
print "=== whole run done ==="
